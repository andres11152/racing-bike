# Entorno de desarrollo local — NO usar estas credenciales en producción.
# Copiar a `.env`:  cp .env.example .env

WP_PORT=8080

DB_NAME=racingbike
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root

# Datos del administrador que crea el script de aprovisionamiento
WP_URL=http://localhost:8080
WP_TITLE="RACING BIKE 1998"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=dev@racingbike.local

# Medición (Fase 00 del plan de conversión). Dejar vacío desactiva el script
GA4_MEASUREMENT_ID=
META_PIXEL_ID=

# Configuración SMTP (Opcional - también configurable en WP-Admin > Ajustes > Configuración SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="RACING BIKE 1998"
